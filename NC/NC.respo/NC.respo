// ============================================================
// NC.respo · Master-Responder
// ============================================================

import { NChoch3 } from "./NChoch3/index.js";
import { NChoch9 } from "./NChoch9/index.js";
import { NChoch81 } from "./NChoch81/index.js";

export const NCRESPO = {

    NC: "NC_RESPO_MASTER",

    respo(etage = 3, info = {}) {

        if (etage === 3) return NChoch3.respo(info);
        if (etage === 9) return NChoch9.respo(info);
        if (etage === 81) return NChoch81.respo(info);

        return {
            NC: this.NC,
            etage,
            farbe: "schwarz",
            impuls: "unbekannt",
            info,
            zeit: new Date().toISOString()
        };
    }
};
