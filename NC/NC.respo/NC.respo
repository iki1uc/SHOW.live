import { NChoch3 } from "./NChoch3/index.js";
import { NChoch9 } from "./NChoch9/index.js";
import { NChoch81 } from "./NChoch81/index.js";

export const NCRESPO = {

    NC: "NC_RESPO_MASTER",

    farben: {
        3: "türkis",
        9: "gold",
        81: "blau"
    },

    respo(etage = 3, info = {}) {

        if (etage === 3) return NChoch3(info);
        if (etage === 9) return NChoch9(info);
        if (etage === 81) return NChoch81(info);

        return {
            NC: this.NC,
            etage,
            farbe: "schwarz",
            impuls: "unbekannt",
            info,
            zeit: new Date().toISOString()
        };
    }
};
